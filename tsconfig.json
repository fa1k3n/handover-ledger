{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "src",
    "test",
    "scripts",
    "schema"
  ],
  "exclude": [
    "src/dashboard/*.tsx",
    "src/dashboard/vite.config.ts",
    "src/dashboard/api.ts"
  ]
}
